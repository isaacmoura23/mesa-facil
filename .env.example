# Copie este arquivo para `.env.local` e preencha os valores.
# `.env.local` está no .gitignore: NUNCA faça commit de credenciais reais.
#
# Passo a passo (Supabase local):
#   1. npx supabase start
#   2. Rode `npx supabase status` e copie "API URL" e a chave anon / publishable.
#   3. Cole abaixo e reinicie `npm run dev`.
#
# As variáveis NEXT_PUBLIC_* são embutidas no código no momento do build:
# defina-as ANTES de `npm run build`.

# URL da API do projeto Supabase.
# Padrão público do Supabase local (não é segredo): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon/publishable). Protegida por RLS, pode ir ao navegador.
# Supabase local: use o valor de "anon key" / "Publishable" exibido por `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) URL pública deste app, usada nos links dos e-mails de confirmação.
# Em desenvolvimento costuma ser http://localhost:3000. Se vazio, é deduzida da requisição.
NEXT_PUBLIC_SITE_URL=

# Service role: IGNORA o RLS. Somente servidor (módulo `server-only`).
# NUNCA use o prefixo NEXT_PUBLIC_ e nunca exponha ao navegador.
# Não é necessária na Fase 1; deixe vazia até haver rotinas administrativas.
SUPABASE_SERVICE_ROLE_KEY=
