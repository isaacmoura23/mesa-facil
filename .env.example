# Copie este arquivo para `.env.local` (desenvolvimento) e preencha os valores.
#   Git Bash: cp .env.example .env.local      PowerShell/cmd: copy .env.example .env.local
# Todo `.env*` (exceto este .env.example) está no .gitignore: NUNCA faça commit de credenciais reais.
#
# Supabase local:
#   1. npm run db:start
#   2. npx supabase status   (copie "API URL" e a chave anon/publishable; para a service role, a "service_role/secret")
#      Se o CLI do npm estiver bloqueado (Windows), veja docs/INSTALACAO.md, seção "Alternativas ao Supabase CLI".
#   3. Cole abaixo e reinicie `npm run dev`.
#
# As variáveis NEXT_PUBLIC_* são embutidas no código NO BUILD: defina-as ANTES de `npm run build`
# (na Vercel: antes do deploy; trocar o valor exige novo deploy).
# Em produção as mesmas variáveis vão para o painel da Vercel; os scripts de publicação usam `.env.deploy`
# (modelo: scripts/deploy/env.deploy.template).

# [obrigatória] URL da API do projeto Supabase.
# Local (padrão público, não é segredo): http://127.0.0.1:54321
# Nuvem: https://<id-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [obrigatória] Chave pública (anon / publishable). Protegida por RLS, pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [recomendada em produção] URL pública deste app (origem, sem barra final), usada nos links de confirmação de e-mail.
# Local: http://localhost:3000.  Produção: https://SEU-SITE.vercel.app. OBRIGATÓRIA em produção: os links dos e-mails de
# confirmação, recuperação de senha e convite saem SEMPRE desta URL (nunca do cabeçalho Host, S-07). Se vazia, o Supabase
# usa o site_url configurado no projeto.
NEXT_PUBLIC_SITE_URL=

# [obrigatória para pedidos] Service role: IGNORA o RLS. Somente servidor (módulo `server-only`).
# Usada pela API pública para gravar pedidos (`create_public_order` só aceita este papel) e por rotinas administrativas.
# NUNCA use o prefixo NEXT_PUBLIC_, nunca exponha ao navegador, nunca cole em chats/prints/commits.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Fase 8 (uso real). Tudo abaixo é OPCIONAL: sem a variável o recurso fica desligado/em fallback seguro e liga sozinho
# quando ela existir. Variáveis NEXT_PUBLIC_* entram no build (defina antes de `npm run build`).
# ---------------------------------------------------------------------------------------------------------------------

# [recomendada em produção] Rate limit compartilhado entre instâncias (Upstash Redis, API REST, plano gratuito).
# Sem estas duas variáveis o limite vale só por instância (memória) e o servidor avisa uma vez no log em produção.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [obrigatória atrás de proxy próprio] Quantos proxies SEUS ficam na frente do app (fora da Vercel). O IP do cliente é o
# valor de x-forwarded-for contado a partir da direita (1 = último valor). Na Vercel não use: o app lê x-real-ip
# (VERCEL=1 é definido pela plataforma). Em produção sem Vercel e sem esta variável, todos os visitantes dividem o mesmo
# balde de limite ("unknown"): seguro, porém restritivo. Em desenvolvimento nada é necessário.
TRUSTED_PROXY_HOPS=

# [opcional] CAPTCHA Cloudflare Turnstile no checkout, no cadastro, na recuperação de senha e na API pública de pedidos.
# Só liga quando AS DUAS existem. Site key é pública (vai ao navegador); secret key é só do servidor.
# Com o captcha ligado, a API pública de pedidos passa a exigir o campo `captchaToken` no corpo do POST.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# [opcional] MFA TOTP obrigatório (aal2) para administradores da plataforma. Padrão: true em produção, false em
# desenvolvimento. Defina "false" para desligar (ex.: testes E2E) ou "true" para forçar em qualquer ambiente.
# Exige MFA TOTP habilitado no Supabase Auth ([auth.mfa.totp] enroll_enabled/verify_enabled = true no config local).
PLATFORM_REQUIRE_MFA=

# ---------------------------------------------------------------------------------------------------------------------
# Somente para os testes (não é lida pelo app; defina no shell, não aqui, se preferir):
#   API_BASE_URL=http://localhost:3100   # servidor do app que tests/api usa (padrão http://localhost:3100)
# Somente publicação (fica em `.env.deploy`, NUNCA em `.env.local`/Vercel):
#   SUPABASE_DB_URL=                      # connection string do Session pooler, com a senha do banco
# ---------------------------------------------------------------------------------------------------------------------
