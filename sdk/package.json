{
  "name": "@mesafacil/storefront-sdk",
  "version": "0.1.0",
  "description": "SDK sem dependências para vitrines personalizadas lerem o cardápio e cotarem carrinhos na API pública do MesaFácil.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "license": "UNLICENSED"
}
