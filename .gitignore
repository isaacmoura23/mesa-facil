# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credenciais locais geradas pelo importador (nunca versionar)
scripts/data/.local-owner-credentials.json

# artefatos locais de agentes/navegador
.playwright-mcp/

# deploy: credenciais geradas para a demo publicada (nunca versionar)
scripts/data/.deploy-credentials.json
.env.deploy

.vercel
.env*
